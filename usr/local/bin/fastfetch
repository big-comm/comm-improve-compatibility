#!/bin/bash
config_dir="${FASTFETCH_CONFIG_DIR:-/etc/fastfetch}"
default_config="$config_dir/config.jsonc"
labels_file="$config_dir/labels.tsv"
config="$default_config"
tmp_config=""

locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
locale="${locale%%.*}"
locale="${locale%%@*}"
lang="${locale%%[_-]*}"

case "$lang" in
    nb|nn) lang="no" ;;
    iw) lang="he" ;;
esac

has_config_arg=false
for arg in "$@"; do
    case "$arg" in
        -c|--config|--config=*)
            has_config_arg=true
            break
            ;;
    esac
done

escape_sed_replacement() {
    printf '%s' "$1" | sed 's/[&|\\]/\\&/g'
}

render_localized_config() {
    local esc_system esc_kernel esc_uptime esc_packages esc_shell esc_desktop
    local esc_theme esc_icons esc_terminal esc_hardware esc_disk esc_display

    esc_system=$(escape_sed_replacement "$label_system")
    esc_kernel=$(escape_sed_replacement "$label_kernel")
    esc_uptime=$(escape_sed_replacement "$label_uptime")
    esc_packages=$(escape_sed_replacement "$label_packages")
    esc_shell=$(escape_sed_replacement "$label_shell")
    esc_desktop=$(escape_sed_replacement "$label_desktop")
    esc_theme=$(escape_sed_replacement "$label_theme")
    esc_icons=$(escape_sed_replacement "$label_icons")
    esc_terminal=$(escape_sed_replacement "$label_terminal")
    esc_hardware=$(escape_sed_replacement "$label_hardware")
    esc_disk=$(escape_sed_replacement "$label_disk")
    esc_display=$(escape_sed_replacement "$label_display")

    sed \
        -e "s|{icon} System|{icon} $esc_system|" \
        -e "s|│ ├ Kernel|│ ├ $esc_kernel|" \
        -e "s|│ ├󰅐 Uptime|│ ├󰅐 $esc_uptime|" \
        -e "s|│ ├󰏖 Packages|│ ├󰏖 $esc_packages|" \
        -e "s|│ └ Shell|│ └ $esc_shell|" \
        -e "s|󰇄 Desktop|󰇄 $esc_desktop|" \
        -e "s|│ ├󰉼 Theme|│ ├󰉼 $esc_theme|" \
        -e "s|│ ├󰀻 Icons|│ ├󰀻 $esc_icons|" \
        -e "s|│ └ Terminal|│ └ $esc_terminal|" \
        -e "s|󰌢 Hardware|󰌢 $esc_hardware|" \
        -e "s|│ ├ Disk|│ ├ $esc_disk|" \
        -e "s|│ └󰍹 Display|│ └󰍹 $esc_display|" \
        "$default_config" > "$tmp_config"
}

if [[ "$has_config_arg" == false && "$lang" != "en" && -f "$labels_file" && -f "$default_config" ]]; then
    labels_found=false
    while IFS=$'\t' read -r label_lang label_system label_kernel label_uptime label_packages label_shell label_desktop label_theme label_icons label_terminal label_hardware label_disk label_display; do
        [[ -z "$label_lang" || "$label_lang" == \#* ]] && continue
        if [[ "$label_lang" == "$lang" ]]; then
            labels_found=true
            break
        fi
    done < "$labels_file"

    if [[ "$labels_found" == true ]]; then
        tmp_dir="${XDG_RUNTIME_DIR:-/tmp}"
        [[ -d "$tmp_dir" && -w "$tmp_dir" ]] || tmp_dir="/tmp"
        tmp_config=$(mktemp "$tmp_dir/fastfetch.XXXXXX.jsonc") || tmp_config=""

        if [[ -n "$tmp_config" ]]; then
            if render_localized_config; then
                config="$tmp_config"
            else
                rm -f "$tmp_config"
                tmp_config=""
            fi
        fi
    fi
fi

args=(--key-width 15)

if [[ "$has_config_arg" == false ]]; then
    if [[ -f "$config" ]]; then
        args+=(--config "$config")
    elif [[ "$config" != "$default_config" && -f "$default_config" ]]; then
        args+=(--config "$default_config")
    fi
fi

if [[ -f "$HOME/.config/fastfetch/ascii-art" ]]; then
    args+=(--file-raw "$HOME/.config/fastfetch/ascii-art")
else
    args+=(--file-raw "$config_dir/ascii-art")
fi

if [[ -n "$tmp_config" ]]; then
    /usr/bin/fastfetch "${args[@]}" "$@"
    status=$?
    rm -f "$tmp_config"
    exit "$status"
fi

exec /usr/bin/fastfetch "${args[@]}" "$@"
